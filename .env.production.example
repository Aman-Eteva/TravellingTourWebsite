SITE_DOMAIN=travel.example.com
ACME_EMAIL=you@example.com
POSTGRES_PASSWORD=replace-with-a-generated-alphanumeric-password
DATABASE_URL=postgresql://travel:replace-with-a-generated-alphanumeric-password@db:5432/travel
JWT_SECRET=replace-with-a-generated-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-generated-random-secret-at-least-32-characters
CLIENT_URL=https://travel.example.com
NODE_ENV=production
PORT=4000
TRUST_PROXY_HOPS=1
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=hello@travel.example.com
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
